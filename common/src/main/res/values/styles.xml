<resources>
    <!-- Application theme -->
    <style name="AppTheme.V21" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/jellyfin_primary</item>
        <item name="colorPrimaryDark">@color/jellyfin_primary_dark</item>
        <item name="colorAccent">@color/vault_accent</item>
        <item name="android:windowBackground">@color/theme_background</item>
        <item name="android:navigationBarColor">@color/theme_background</item>
    </style>

    <style name="AppTheme" parent="AppTheme.V21" />

    <!-- Launch theme. ic_splash draws the app's own launcher layers, so every app shares it -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/theme_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
