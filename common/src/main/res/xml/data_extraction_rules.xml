<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for cloud backups and for moving to a new
     phone alike. The databases hold the server sign-in, so it never leaves the device; LiveVault's
     record of the streams it left open stays behind too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="downloaded" />
        <exclude domain="sharedpref" path="live_streams.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="downloaded" />
        <exclude domain="sharedpref" path="live_streams.xml" />
    </device-transfer>
</data-extraction-rules>
